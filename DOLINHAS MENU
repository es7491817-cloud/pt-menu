-- LÓGICA DO AIMBOT (Fixado perfeitamente na cabeça)
local aimbotEnabled = false
local aimConnection = nil
local isMouseDown = false
local maxDistance = 300

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isMouseDown = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isMouseDown = false
	end
end)

local function getClosestTarget()
	local closestTarget = nil
	local shortestDistance = maxDistance

	local localCharacter = player.Character
	if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local localPosition = localCharacter.HumanoidRootPart.Position

	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("Humanoid") and object.Health > 0 then
			local character = object.Parent
			if character ~= localCharacter then
				local targetHead = character:FindFirstChild("Head")
				if targetHead then
					local distance = (targetHead.Position - localPosition).Magnitude
					if distance < shortestDistance then
						shortestDistance = distance
						closestTarget = targetHead
					end
				end
			end
		end
	end

	return closestTarget
end

toggle(aim, "Aimbot", "Fixa a mira na cabeça ao segurar o botão direito", function(state)
	aimbotEnabled = state

	if aimbotEnabled then
		aimConnection = RunService.RenderStepped:Connect(function()
			if isMouseDown then
				local targetHead = getClosestTarget()
				if targetHead then
					-- Direciona a câmera diretamente para a cabeça sem nenhum atraso, mesmo se o boneco se mover
					camera.CFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)
				end
			end
		end)
	else
		if aimConnection then
			aimConnection:Disconnect()
			aimConnection = nil
		end
	end
end)


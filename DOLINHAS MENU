local function create(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function round(obj, radius)
	create("UICorner", {
		CornerRadius = UDim.new(0, radius or 8)
	}, obj)
end

local function outline(obj)
	create("UIStroke", {
		Color = RED,
		Thickness = 1,
		Transparency = 0.3
	}, obj)
end

